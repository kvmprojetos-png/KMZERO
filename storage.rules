rules_version = '2';

// Fotos privadas passam pela API autenticada /api/foto, que verifica token revogado,
// empresa, perfil ativo, área e obra antes de usar Firebase Admin. Acesso direto do
// SDK do cliente fica negado, inclusive getDownloadURL e metadados com tokens.
// URLs antigas de download exigem remoção administrativa do token já emitido.
service firebase.storage {
  match /b/{bucket}/o {
    match /{objeto=**} {
      allow read, write: if false;
    }
  }
}
