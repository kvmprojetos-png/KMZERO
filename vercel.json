{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-avisos?etapa=tarde",
      "schedule": "0 19 * * 1-5"
    },
    {
      "path": "/api/cron-avisos?etapa=noite",
      "schedule": "0 22 * * *"
    }
  ]
}
