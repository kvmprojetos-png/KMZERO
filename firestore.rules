rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// KMZERO — Regras do Firestore (multiempresa / SaaS)
//
// Modelo de dados:
//   usuarios/{uid}                     perfil de cada login Google (empresaId, perfil, ativo, acessos...)
//   convites/{email}                   convite do gestor: "este Gmail entra na empresa X como Y"
//                                      (com as áreas do escritório em "acessos", se for gestor)
//   empresas/{empresaId}               cadastro da empresa (gestorUid = quem criou)
//   empresas/{empresaId}/{colecao}/*   obras, trabalhadores, pedidos, rdos, presencas...
//
// Princípios:
//   - cada usuário só enxerga a empresa gravada no SEU perfil;
//   - ninguém cria perfil para si mesmo, exceto (a) quem acabou de criar a própria
//     empresa ou (b) quem tem um convite para o e-mail VERIFICADO da sua conta Google.
// Publicar com:  npm run firebase:deploy-regras
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function caminhoPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function temPerfil() {
      return logado() && exists(caminhoPerfil());
    }
    function perfil() {
      return get(caminhoPerfil()).data;
    }
    // Perfil existe e não foi desativado pelo gestor
    function perfilAtivo() {
      return temPerfil() && perfil().get('ativo', true) != false;
    }
    function minhaEmpresa() {
      return perfil().empresaId;
    }
    function souGestor() {
      return perfilAtivo() && perfil().perfil == 'gestor';
    }
    function souDaEmpresa(empresaId) {
      return perfilAtivo() && minhaEmpresa() == empresaId;
    }
    // A empresa existe e foi criada por este uid (o DONO da empresa: empresas/{id}.gestorUid)
    function ehDono(empresaId, uid) {
      return exists(/databases/$(database)/documents/empresas/$(empresaId))
        && get(/databases/$(database)/documents/empresas/$(empresaId)).data.gestorUid == uid;
    }
    // A empresa já existe e foi criada por quem está logado (usado no cadastro do gestor)
    function empresaCriadaPorMim(empresaId) {
      return ehDono(empresaId, request.auth.uid);
    }
    // E-mail da conta Google de quem está logado, em minúsculas (é a chave do convite)
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function emailVerificado() {
      return logado() && request.auth.token.get('email_verified', false) == true;
    }
    function caminhoConvite() {
      return /databases/$(database)/documents/convites/$(meuEmail());
    }
    // Áreas do escritório (campo "acessos" de usuarios/ e convites/):
    //   null ou ausente = acesso total (todo gestor antigo continua assim);
    //   lista de ids de grupos do menu (ex.: ['visao', 'financeiro']) = só essas áreas.
    // Quem esconde as telas é o app. Aqui: o formato; ninguém muda as PRÓPRIAS áreas;
    // só quem administra os acessos (Tudo ou a área 'sistema') convida e muda tipo,
    // áreas ou ativo de outra pessoa; ninguém limita, rebaixa ou desativa o dono;
    // quem foi desativado não volta sozinho (não apaga o próprio perfil para refazê-lo
    // pelo convite, e o convite de quem foi desativado fica com ativo: false).
    // ATENÇÃO: as áreas NÃO trancam os dados. Todo usuário ativo da empresa segue lendo
    // e gravando empresas/{id}/* (ver o fim do arquivo).
    function acessosDe(d) {
      return d.get('acessos', null);
    }
    function acessosValidos(d) {
      return acessosDe(d) == null || acessosDe(d) is list;
    }
    function mantemAcessos() {
      return acessosDe(request.resource.data) == acessosDe(resource.data);
    }
    // Gestor que administra os acessos da empresa: acesso total ou com a área Sistema
    // (é quem abre Sistema → Usuários e acessos no app)
    function possoAdministrar() {
      return souGestor()
        && (perfil().get('acessos', null) == null || 'sistema' in perfil().get('acessos', null));
    }
    // O e-mail do perfil liga o perfil ao convite (convites/{email}): o app nunca o troca
    function mantemEmail() {
      return request.resource.data.get('email', '') == resource.data.get('email', '');
    }
    // A gravação não mexe em tipo de acesso, ativo, áreas nem e-mail (nome, cargo, obra, telefone...)
    function mantemPoderes() {
      return request.resource.data.perfil == resource.data.perfil
        && request.resource.data.get('ativo', true) == resource.data.get('ativo', true)
        && mantemAcessos()
        && mantemEmail();
    }
    // Só desliga alguém da equipe de campo (Equipe → remover trabalhador → "desativar o acesso")
    function soDesligaCampo() {
      return resource.data.perfil != 'gestor'
        && request.resource.data.perfil == resource.data.perfil
        && request.resource.data.get('ativo', true) == false
        && mantemAcessos()
        && mantemEmail();
    }
    // O dono volta a ser escritório com acesso total no PRÓPRIO perfil (nunca fica trancado para fora)
    function donoSeRestaurando(uid) {
      return ehDono(resource.data.empresaId, uid)
        && request.resource.data.perfil == 'gestor'
        && request.resource.data.get('ativo', true) == resource.data.get('ativo', true)
        && acessosDe(request.resource.data) == null;
    }
    // Existe convite para o meu e-mail, ele não foi desligado (desativar a pessoa em Usuários e
    // acessos grava ativo: false também no convite dela) e bate com o perfil que estou criando
    // (empresa, tipo de acesso e as áreas do escritório: ninguém entra com mais do que foi convidado)
    function conviteValeParaMim(novo) {
      return emailVerificado()
        && exists(caminhoConvite())
        && get(caminhoConvite()).data.get('ativo', true) != false
        && get(caminhoConvite()).data.empresaId == novo.empresaId
        && get(caminhoConvite()).data.perfil == novo.perfil
        && get(caminhoConvite()).data.get('acessos', null) == acessosDe(novo);
    }

    // ── Perfis de login ─────────────────────────────────────────────────────
    match /usuarios/{uid} {
      // Ler um perfil: o próprio usuário, ou o gestor da mesma empresa
      allow get: if logado() && (
        request.auth.uid == uid
        || (souGestor() && resource.data.empresaId == minhaEmpresa())
      );
      // Listar a equipe: qualquer usuário ativo da empresa, filtrando pela própria empresa
      allow list: if logado() && perfilAtivo() && resource.data.empresaId == minhaEmpresa();

      // Criar:
      //  (a) gestor concluindo o cadastro da própria empresa (empresa já criada por ele)
      //  (b) pessoa convidada entrando pela 1ª vez com a conta Google do e-mail convidado
      //  (c) quem administra os acessos criando o perfil de alguém da sua empresa (uso administrativo/testes)
      // Em (a) e (b) o e-mail do perfil é o da própria conta Google: é ele que liga o perfil ao
      // convite dele (ninguém se refaz com o e-mail do convite de outra pessoa)
      allow create: if logado() && acessosValidos(request.resource.data) && (
        (request.auth.uid == uid
          && request.resource.data.perfil == 'gestor'
          && request.resource.data.get('email', '') == meuEmail()
          && empresaCriadaPorMim(request.resource.data.empresaId))
        || (request.auth.uid == uid
          && request.resource.data.get('ativo', true) == true
          && request.resource.data.get('email', '') == meuEmail()
          && conviteValeParaMim(request.resource.data))
        || (possoAdministrar()
          && uid != request.auth.uid
          && request.resource.data.empresaId == minhaEmpresa()
          && request.resource.data.perfil != 'gestor')
      );

      // Atualizar (nunca muda a empresa; acessos, quando vier, é null = tudo ou lista):
      //  - perfil de OUTRA pessoa da empresa, por um gestor:
      //      nome, cargo, obra, telefone: qualquer gestor;
      //      desligar alguém da equipe de campo: qualquer gestor;
      //      tipo, áreas, religar, desligar gestor: só quem administra os acessos;
      //      do dono da empresa, ninguém muda tipo, áreas nem ativo;
      //  - o PRÓPRIO perfil: dados simples (não muda perfil, ativo nem áreas), menos
      //    o dono, que pode se devolver o acesso total (donoSeRestaurando)
      allow update: if logado() && acessosValidos(request.resource.data) && (
        (souGestor()
          && uid != request.auth.uid
          && resource.data.empresaId == minhaEmpresa()
          && request.resource.data.empresaId == resource.data.empresaId
          && (mantemPoderes()
            || (!ehDono(resource.data.empresaId, uid)
              && (soDesligaCampo() || possoAdministrar()))))
        || (request.auth.uid == uid
          && request.resource.data.empresaId == resource.data.empresaId
          && (mantemPoderes() || donoSeRestaurando(uid)))
      );

      // Apagar: o próprio, enquanto ativo (direito de exclusão; quem foi desativado pede a quem
      // administra, senão apagaria o perfil desligado e o refaria ativo pelo convite), ou quem
      // administra os acessos (nunca o dono)
      allow delete: if logado() && (
        (request.auth.uid == uid
          && (resource == null || resource.data.get('ativo', true) != false))
        || (possoAdministrar()
          && resource.data.empresaId == minhaEmpresa()
          && !ehDono(resource.data.empresaId, uid))
      );
    }

    // ── Convites (chave = e-mail em minúsculas) ─────────────────────────────
    match /convites/{email} {
      // A pessoa convidada lê o convite do PRÓPRIO e-mail; o gestor lê os da sua empresa
      allow get: if logado() && (
        email == meuEmail()
        || (souGestor() && resource.data.empresaId == minhaEmpresa())
      );
      allow list: if logado() && souGestor() && resource.data.empresaId == minhaEmpresa();
      // Só quem administra os acessos convida, sempre para a própria empresa, e a chave tem de
      // ser o e-mail do documento. Ninguém cria nem edita o convite do PRÓPRIO e-mail (senão
      // apagaria o próprio perfil e o refaria pelo caminho (b) com mais áreas)
      allow create: if logado() && possoAdministrar()
        && email != meuEmail()
        && request.resource.data.empresaId == minhaEmpresa()
        && request.resource.data.email == email
        && request.resource.data.perfil in ['gestor', 'encarregado']
        && acessosValidos(request.resource.data);
      allow update: if logado() && possoAdministrar()
        && email != meuEmail()
        && resource.data.empresaId == minhaEmpresa()
        && request.resource.data.empresaId == minhaEmpresa()
        && request.resource.data.email == email
        && request.resource.data.perfil in ['gestor', 'encarregado']
        && acessosValidos(request.resource.data);
      allow delete: if logado() && possoAdministrar() && resource.data.empresaId == minhaEmpresa();
    }

    // ── Empresas ────────────────────────────────────────────────────────────
    match /empresas/{empresaId} {
      // Qualquer usuário logado pode criar a SUA empresa (cadastro)
      allow create: if logado() && request.resource.data.gestorUid == request.auth.uid;
      allow get: if logado() && souDaEmpresa(empresaId);
      allow list: if false;
      // Só quem administra (acesso total ou área Sistema) edita o cadastro da empresa (e não troca o dono)
      allow update: if logado() && possoAdministrar() && minhaEmpresa() == empresaId
        && request.resource.data.gestorUid == resource.data.gestorUid;
      // Quem criou a empresa pode apagá-la (inclusive para desfazer um cadastro que parou no meio)
      allow delete: if logado() && resource.data.gestorUid == request.auth.uid;

      // Todos os dados da empresa: qualquer usuário ativo DA empresa. As áreas do escritório
      // (acessos) NÃO valem aqui: um gestor "Financeiro" ainda lê e grava obras, folha,
      // pedidos... por fora do app. Separar por área é outro projeto.
      match /{colecao}/{docId} {
        allow read, write: if logado() && souDaEmpresa(empresaId);
      }
    }
  }
}
