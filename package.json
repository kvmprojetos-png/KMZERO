{
  "name": "kmzero",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "overrides": {
    "@firebase/firestore": { "@grpc/grpc-js": "^1.14.5" },
    "gaxios@6": { "uuid": "^11.1.1" },
    "google-gax@4": { "uuid": "^11.1.1" },
    "teeny-request@9": { "uuid": "^11.1.1" }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:security": "node --test tests/*.test.mjs",
    "test:security:rules": "npx firebase-tools@15 emulators:exec --project demo-kmzero-security --config firebase.security-tests.json --only firestore,storage \"node scripts/testar-regras-seguranca.mjs\"",
    "firebase:login": "npx -y firebase-tools@15 login",
    "firebase:deploy-regras": "npx -y firebase-tools@15 deploy --only firestore:rules,storage",
    "firebase:testar": "node scripts/testar-firebase.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "firebase-admin": "13.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.1.0"
  }
}
